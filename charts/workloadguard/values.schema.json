{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "protectedNamespaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "podCIDRs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}},
    "hardening": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultCPURequest": {"type": "string", "minLength": 1},
        "defaultMemoryRequest": {"type": "string", "minLength": 1},
        "defaultMemoryLimit": {"type": "string", "minLength": 1},
        "rolloutTimeout": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"}
      }
    },
    "shutdownTimeout": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"},
    "logLevel": {"type": "string", "enum": ["debug", "info", "warn", "error"]},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressFrom": {"type": "array", "items": {"type": "object"}}
      }
    },
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"},
    "resources": {"type": "object"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    }
  }
}
